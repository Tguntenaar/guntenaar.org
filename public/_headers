# Cloudflare Pages header rules.

# Portrait filenames are stable across a photo swap, so a long max-age would
# serve a stale face to anyone who had already visited. Short freshness window,
# then serve-stale-while-revalidating: repeat visits still render instantly and
# a replaced portrait reaches everyone within the hour.
/portraits/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/canal.webp
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
